{
  "id": "/",
  "name": "Selah",
  "short_name": "Selah",
  "description": "Notes, study and devotion: pause, reflect, write it down",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#fbfaf7",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/*", "*/*"] }]
    }
  },
  "icons": [
    { "src": "/icons/icon-192.png?v=4", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png?v=4", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png?v=4", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
