<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Selah Desktop on a Mac, with the hardened runtime notarizing needs. JIT and unsigned executable memory: V8, in the
     window and in the local server (Electron run as Node), and WebAssembly OCR. Library validation off: the server's
     ffmpeg and Electron's own frameworks load under the app's signature. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
