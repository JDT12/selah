[Unit]
Description=Note App (self-hosted notes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__NODE__ server/index.js
Environment=NODE_ENV=production
Environment=NOTEAPP_PORT=8443
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
